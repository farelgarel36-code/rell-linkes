# Copy to .env and change every secret before deployment
PORT=3000
NODE_ENV=production
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_USERNAME=admin
# Generate a bcrypt hash for your password using: node -e "console.log(require('bcryptjs').hashSync('YOUR_STRONG_PASSWORD', 12))"
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash
# On hosting, use persistent disk storage and set this to its mounted path
DATA_DIR=./data
MAX_FILE_MB=500
